          "raw": "http://localhost:8080/api/chat/conversations/{{conversationId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "chat", "conversations", "{{conversationId}}"]
        }
      }
    },
    {

      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expediteur\": \"CLIENT\",\n  \"contenu\": \"Bonjour, j'ai besoin d'aide pour ma réservation\"\n}"
